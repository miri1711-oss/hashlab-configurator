# Skopíruj tento súbor ako ".env" (bez "example.") a doplň skutočné hodnoty.
# Súbor .env sa NIKDY nesmie commitnúť do gitu (obsahuje heslá) - .gitignore
# nižšie v tomto priečinku je nastavený tak, aby ho ignoroval.

# --- hashlab-configurator API ---
ORDERS_API_URL=https://hashlab-configurator.vercel.app
ORDERS_VIEW_KEY=sem-daj-to-iste-heslo-ako-vo-verceli-ORDERS_VIEW_KEY

# --- Bambu Lab tlačiareň (lokálna sieť) ---
# IP adresu nájdeš na displeji tlačiarne (Nastavenia -> WiFi), sériové číslo
# a prístupový kód tiež priamo na tlačiarni (Nastavenia -> Zariadenie).
PRINTER_IP=192.168.1.50
PRINTER_SERIAL=01P00A000000000
PRINTER_ACCESS_CODE=12345678

# --- Slicer (na prevod STL -> G-code) ---
# Cesta k príkazovému riadku Bambu Studio alebo OrcaSlicer nainštalovaného
# na tomto počítači. Presný názov/cestu treba doplniť podľa toho, kde a ako
# je slicer u teba nainštalovaný (líši sa podľa verzie a OS).
SLICER_CLI_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio

# Ako často (v sekundách) sa má skript pýtať na nové objednávky.
POLL_INTERVAL_SECONDS=60
